{
  "manifest_version": 3,
  "name": "fastcdp",
  "version": "1.1",
  "description": "Drive Chrome via CDP, from fastcdp kernels or Solveit; plus Solveit file-system access",
  "permissions": ["storage", "debugger", "tabs", "alarms"],
  "options_ui": {"page": "options.html"},
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["http://localhost:*/*", "https://*.solve.it.com/*"],
      "js": ["idb-keyval-6.2.2-umd.min.js", "content.js"],
      "world": "MAIN"
    },
    {
      "matches": ["http://localhost:*/*", "https://*.solve.it.com/*"],
      "js": ["bridge.js"]
    }
  ],
  "host_permissions": ["http://127.0.0.1:*/*", "http://localhost:*/*", "https://*.solve.it.com/*"]
}
