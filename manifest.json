{
  "manifest_version": 3,
  "name": "SolveIt Connector",
  "version": "1.1",
  "description": "Connect SolveIt with Chrome",
  "permissions": ["activeTab", "storage", "debugger", "tabs"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["http://localhost:*/*"],
      "js": ["idb-keyval-6.2.2-umd.min.js", "content.js"],
      "world": "MAIN"
    },
    {
      "matches": ["http://localhost:*/*"],
      "js": ["bridge.js"]
    }
  ]
}
